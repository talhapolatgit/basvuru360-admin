{
  "info": {
    "_postman_id": "b360-api-v1",
    "name": "Basvuru360 API v1",
    "description": "Vatandaş portalı / mobil için JWT API (kişi auth).\n\n1) Health veya Genel Ayarlar ile public test edin.\n2) Auth → Register veya Login ile access_token alın.\n3) Collection variable `access_token` otomatik set edilir.\n4) Me / Başvurular / Profil için Authorization: Bearer {{access_token}} kullanın.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8001/api/v1"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "tc_kimlik_no",
      "value": "10000000146"
    },
    {
      "key": "password",
      "value": "password"
    },
    {
      "key": "email",
      "value": "ayşe.yılmaz@ornek.test"
    },
    {
      "key": "dogum_tarihi",
      "value": "1990-01-15"
    },
    {
      "key": "kurs_id",
      "value": "1"
    },
    {
      "key": "etkinlik_id",
      "value": "1"
    },
    {
      "key": "basvuru_id",
      "value": "1"
    },
    {
      "key": "iptal_gerekce_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/health"
          }
        },
        {
          "name": "Genel Ayarlar",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/genel-ayarlar"
          }
        },
        {
          "name": "Kurum Logosu",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/logo",
            "description": "Logo görselini binary olarak döner (image/png|jpeg|svg|webp). Yönetim paneli statik yoluna bağlı değildir."
          }
        },
        {
          "name": "Sidebar Logosu",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/sidebar-logo",
            "description": "Portal sidebar logosunu binary olarak döner (image/png|jpeg|svg|webp)."
          }
        },
        {
          "name": "Aktif Kurslar",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/kurslar?per_page=15",
              "host": ["{{base_url}}"],
              "path": ["kurslar"],
              "query": [
                { "key": "per_page", "value": "15" },
                { "key": "page", "value": "1", "disabled": true },
                { "key": "merkez_id", "value": "", "disabled": true },
                { "key": "alan_id", "value": "", "disabled": true },
                { "key": "brans_id", "value": "", "disabled": true },
                { "key": "kurs_tipi_id", "value": "", "disabled": true },
                { "key": "basvuru_durumu", "value": "acik", "disabled": true },
                { "key": "q", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Kurs Detay",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/kurslar/{{kurs_id}}"
          }
        },
        {
          "name": "Aktif Etkinlikler",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/etkinlikler?per_page=15",
              "host": ["{{base_url}}"],
              "path": ["etkinlikler"],
              "query": [
                { "key": "per_page", "value": "15" },
                { "key": "merkez_id", "value": "", "disabled": true },
                { "key": "etkinlik_tipi_id", "value": "", "disabled": true },
                { "key": "q", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Etkinlik Detay",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/etkinlikler/{{etkinlik_id}}"
          }
        }
      ]
    },
    {
      "name": "Lookups",
      "item": [
        {
          "name": "Merkezler",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/lookups/merkezler"
          }
        },
        {
          "name": "Alanlar",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/lookups/alanlar"
          }
        },
        {
          "name": "Branşlar",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/lookups/branslar?alan_id="
          }
        },
        {
          "name": "Kurs Tipleri",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/lookups/kurs-tipleri"
          }
        },
        {
          "name": "Etkinlik Tipleri",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/lookups/etkinlik-tipleri"
          }
        },
        {
          "name": "İptal Gerekçeleri",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/lookups/iptal-gerekceleri"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.access_token) { pm.collectionVariables.set('access_token', json.data.access_token); }",
                  "if (json?.data?.refresh_token) { pm.collectionVariables.set('refresh_token', json.data.refresh_token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ad\": \"Ayşe\",\n  \"soyad\": \"Yılmaz\",\n  \"tc_kimlik_no\": \"{{tc_kimlik_no}}\",\n  \"dogum_tarihi\": \"{{dogum_tarihi}}\",\n  \"telefon\": \"05551112233\",\n  \"email\": \"ayse@ornek.test\",\n  \"il\": \"İstanbul\",\n  \"ilce\": \"Kadıköy\",\n  \"adres\": \"Örnek Mah. No:1\",\n  \"cinsiyet\": \"kadin\",\n  \"password\": \"{{password}}\",\n  \"password_confirmation\": \"{{password}}\"\n}"
            },
            "url": "{{base_url}}/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.access_token) { pm.collectionVariables.set('access_token', json.data.access_token); }",
                  "if (json?.data?.refresh_token) { pm.collectionVariables.set('refresh_token', json.data.refresh_token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tc_kimlik_no\": \"{{tc_kimlik_no}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.access_token) { pm.collectionVariables.set('access_token', json.data.access_token); }",
                  "if (json?.data?.refresh_token) { pm.collectionVariables.set('refresh_token', json.data.refresh_token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{base_url}}/auth/refresh"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/auth/me"
          }
        },
        {
          "name": "Profil Güncelle",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telefon\": \"05551112233\",\n  \"email\": \"ayse@ornek.test\",\n  \"il\": \"İstanbul\",\n  \"ilce\": \"Kadıköy\",\n  \"adres\": \"Örnek Mah. No:1\",\n  \"cinsiyet\": \"kadin\"\n}"
            },
            "url": "{{base_url}}/auth/profil"
          }
        },
        {
          "name": "Şifre Güncelle",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"{{password}}\",\n  \"password\": \"password\",\n  \"password_confirmation\": \"password\"\n}"
            },
            "url": "{{base_url}}/auth/sifre"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{base_url}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Başvurular",
      "item": [
        {
          "name": "Başvurularım",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/basvurularim"
          }
        },
        {
          "name": "Kurs Başvurusu Oluştur",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "kurs_id", "value": "{{kurs_id}}", "type": "text" },
                { "key": "il", "value": "İstanbul", "type": "text" },
                { "key": "ilce", "value": "Kadıköy", "type": "text" },
                { "key": "adres", "value": "Örnek Mah. No:1", "type": "text" },
                { "key": "telefon", "value": "05551112233", "type": "text" },
                { "key": "cinsiyet", "value": "kadin", "type": "text" }
              ]
            },
            "url": "{{base_url}}/kurs-basvurulari",
            "description": "Zorunlu evrak varsa form-data'ya evrak.{tip_id} file alanları ekleyin."
          }
        },
        {
          "name": "Kurs Başvurusu Detay",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/kurs-basvurulari/{{basvuru_id}}"
          }
        },
        {
          "name": "Kurs Başvurusu İptal",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"iptal_gerekce_id\": {{iptal_gerekce_id}}\n}"
            },
            "url": "{{base_url}}/kurs-basvurulari/{{basvuru_id}}/iptal"
          }
        },
        {
          "name": "Etkinlik Başvurusu Oluştur",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "etkinlik_id", "value": "{{etkinlik_id}}", "type": "text" },
                { "key": "il", "value": "İstanbul", "type": "text" },
                { "key": "ilce", "value": "Kadıköy", "type": "text" },
                { "key": "adres", "value": "Örnek Mah. No:1", "type": "text" },
                { "key": "telefon", "value": "05551112233", "type": "text" }
              ]
            },
            "url": "{{base_url}}/etkinlik-basvurulari"
          }
        },
        {
          "name": "Etkinlik Başvurusu İptal",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"iptal_gerekce_id\": {{iptal_gerekce_id}}\n}"
            },
            "url": "{{base_url}}/etkinlik-basvurulari/{{basvuru_id}}/iptal"
          }
        }
      ]
    }
  ]
}
